package part6;
public class MovesZerosToEndUsingTwoPointerApproach{
    public static void moveZeroes(int[] nums) {
        int nums_length = nums.length;
        int left = 0;
        for(int right=0; right<nums_length; right++)
        {
            if(nums[right] !=0) {
                int temp = nums[right];
                nums[right] = nums[left];
                nums[left] = temp;
                left++;
            }

        }
        for(int number : nums){
            System.out.print(number+ " ");
        }
    }
        public static void main(String[] args){
             int [] nums = {1,0,3,0,10,8,0,80098};
            moveZeroes(nums);
        }
}
